# Content Editor packages and temporary staging trees
/dist/
/.content-editor-runtime/

# Engine source comes from the pinned or linked Gen1Recomp runtime.
# Local copies here shadow that runtime and drift.
/src/

# Local ROM-derived caches and private game data
/data/generated/
/assets/generated/
portable.txt
*.gb
*.gbc
*.gba

# Local content projects; keep only the bundled starter under version control
/mods/*/
!/mods/my_content/

# Tool caches
__pycache__/
*.pyc
.DS_Store
Thumbs.db
gen3-rom-path.txt
